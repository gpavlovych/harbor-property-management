@model ApplicationPageViewModel
<div id="manager-notes" class="card shadow-sm mb-4 border-warning-subtle">
    <div class="card-header bg-warning-subtle d-flex justify-content-between align-items-center">
        <span class="fw-semibold"><i class="bi bi-journal-text me-1"></i>Manager notes</span>
        <button type="button" class="btn btn-sm btn-outline-secondary" data-modal-url="@Url.Action("Notes", "Applications", new { id = Model.Id })"><i class="bi bi-pencil"></i></button>
    </div>
    <div class="card-body small">
        @if (string.IsNullOrWhiteSpace(Model.ManagerNotes))
        {
            <span class="text-muted">No notes yet. Notes are private to property managers.</span>
        }
        else
        {
            <div class="preserve-lines">@Model.ManagerNotes</div>
        }
    </div>
</div>
