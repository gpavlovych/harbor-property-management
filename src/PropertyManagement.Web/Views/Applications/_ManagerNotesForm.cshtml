@model ManagerNotesViewModel
<div class="modal-header">
    <h5 class="modal-title">Manager notes</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<form asp-controller="Applications" asp-action="Notes" method="post" data-modal-form>
    <input type="hidden" asp-for="ApplicationId" />
    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
        <p class="text-muted small">These notes are visible to property managers only and are never shown to the applicant.</p>
        <textarea asp-for="Notes" class="form-control" rows="6" autofocus></textarea>
        <span asp-validation-for="Notes" class="text-danger small"></span>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save notes</button>
    </div>
</form>
