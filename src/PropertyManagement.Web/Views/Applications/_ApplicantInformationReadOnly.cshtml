@model ApplicantInformationViewModel
<dl class="row mb-0 readonly-fields">
    <dt class="col-sm-4">Full name</dt><dd class="col-sm-8">@(Model.FullName ?? "—")</dd>
    <dt class="col-sm-4">Phone</dt><dd class="col-sm-8">@(Model.Phone ?? "—")</dd>
    <dt class="col-sm-4">Email</dt><dd class="col-sm-8">@(Model.Email ?? "—")</dd>
    <dt class="col-sm-4">Current address</dt><dd class="col-sm-8">@(Model.CurrentAddress ?? "—")</dd>
</dl>
