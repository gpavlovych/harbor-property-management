@model ApplicationPageViewModel
<div class="mb-3">
    <h4 class="mb-1">Applicant Information</h4>
    <p class="text-muted mb-0">
        Tell us how to reach you.
        @if (Model.ApplicantInformationCompleted)
        {
            <span class="badge text-bg-success ms-1"><i class="bi bi-check-lg"></i> Section saved</span>
        }
    </p>
</div>
@if (Model.IsEditable)
{
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="ApplicantInformation.FullName" class="form-label"></label>
            <input asp-for="ApplicantInformation.FullName" class="form-control" />
            <span asp-validation-for="ApplicantInformation.FullName" class="text-danger small"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="ApplicantInformation.Phone" class="form-label"></label>
            <input asp-for="ApplicantInformation.Phone" class="form-control" type="tel" />
            <span asp-validation-for="ApplicantInformation.Phone" class="text-danger small"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="ApplicantInformation.Email" class="form-label"></label>
            <input asp-for="ApplicantInformation.Email" class="form-control" type="email" />
            <span asp-validation-for="ApplicantInformation.Email" class="text-danger small"></span>
        </div>
        <div class="col-md-12 mb-3">
            <label asp-for="ApplicantInformation.CurrentAddress" class="form-label"></label>
            <input asp-for="ApplicantInformation.CurrentAddress" class="form-control" />
            <span asp-validation-for="ApplicantInformation.CurrentAddress" class="text-danger small"></span>
        </div>
    </div>
}
else
{
    <partial name="~/Views/Applications/_ApplicantInformationReadOnly.cshtml" model="Model.ApplicantInformation" />
}
