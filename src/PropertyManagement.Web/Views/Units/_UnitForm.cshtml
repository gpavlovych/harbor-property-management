@model UnitFormViewModel
<div class="modal-header">
    <h5 class="modal-title">@(Model.IsNew ? "Add unit" : $"Edit unit {Model.UnitNumber}")</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<form asp-controller="Units" asp-action="@(Model.IsNew ? "Create" : "Edit")" method="post" data-modal-form>
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="PropertyId" />
    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="UnitNumber" class="form-label"></label>
                <input asp-for="UnitNumber" class="form-control" autofocus />
                <span asp-validation-for="UnitNumber" class="text-danger small"></span>
            </div>
            <div class="col-md-8 mb-3">
                <label asp-for="UnitTypeId" class="form-label"></label>
                <select asp-for="UnitTypeId" class="form-select" asp-items="@(new SelectList(Model.UnitTypeOptions, "Id", "Name"))">
                    <option value="">Choose a type…</option>
                </select>
                <span asp-validation-for="UnitTypeId" class="text-danger small"></span>
                <div class="form-text">Inactive unit types are only listed when the unit already uses one.</div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="Bedrooms" class="form-label"></label>
                <input asp-for="Bedrooms" class="form-control" type="number" min="0" max="20" />
                <span asp-validation-for="Bedrooms" class="text-danger small"></span>
            </div>
            <div class="col-md-8 mb-3">
                <label asp-for="MonthlyRent" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input asp-for="MonthlyRent" class="form-control" type="number" min="1" step="1" />
                </div>
                <span asp-validation-for="MonthlyRent" class="text-danger small"></span>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">@(Model.IsNew ? "Add unit" : "Save changes")</button>
    </div>
</form>
