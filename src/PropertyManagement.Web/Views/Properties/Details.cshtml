@model PropertyDetail
@{
    ViewData["Title"] = Model.Name;
}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-action="Index">Properties</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
    </ol>
</nav>

<div class="card shadow-sm mb-4">
    <div class="card-body d-flex justify-content-between align-items-start flex-wrap gap-2">
        <div>
            <h1 class="h3 mb-1">@Model.Name</h1>
            <div class="text-muted"><i class="bi bi-geo-alt me-1"></i>@Model.FullAddress</div>
        </div>
        <div class="text-nowrap">
            <button type="button" class="btn btn-outline-secondary btn-sm" data-modal-url="@Url.Action("Edit", new { id = Model.Id, mode = "details" })"><i class="bi bi-pencil me-1"></i>Edit</button>
            <button type="button" class="btn btn-outline-danger btn-sm" data-modal-url="@Url.Action("Delete", new { id = Model.Id, mode = "details" })"><i class="bi bi-trash me-1"></i>Remove</button>
        </div>
    </div>
</div>

@await Component.InvokeAsync("UnitsTable", new { propertyId = Model.Id })
