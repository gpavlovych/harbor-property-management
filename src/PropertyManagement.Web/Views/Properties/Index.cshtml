@model List<PropertySummary>
@{
    ViewData["Title"] = "Properties";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Properties</h1>
    <button type="button" class="btn btn-primary" data-modal-url="@Url.Action("Create")"><i class="bi bi-plus-lg me-1"></i>Add property</button>
</div>
<partial name="_PropertyList" model="Model" />
