@model ResidenceList
@{
    var completed = ViewData["Completed"] is true;
}
<div class="mb-3">
    <h4 class="mb-1">Residence History</h4>
    <p class="text-muted mb-0">
        List the places you have lived before, with your landlord's contact details. At least one prior residence is required.
        @if (completed)
        {
            <span class="badge text-bg-success ms-1"><i class="bi bi-check-lg"></i> Section saved</span>
        }
    </p>
</div>
<partial name="~/Views/Applications/_ResidenceList.cshtml" model="Model" />
